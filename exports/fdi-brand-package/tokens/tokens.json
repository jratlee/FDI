{
  "$description": "False Dawn Industries design tokens (W3C design-tokens format, importable into Figma via Tokens Studio). System of record: Signal Neo-Brutalism (adopted July 2026; see DESIGN.md). Signal Amber is the primary action color; Signal Orange is the secondary alert accent AND the logo mark (the old orange-is-logo-only rule is retired).",
  "color": {
    "background": {
      "base": { "$type": "color", "$value": "#0D0B08", "$description": "Base Dark (Parchment Night): page background; also the text color on signal panels" },
      "surface-container-lowest": { "$type": "color", "$value": "#110e05", "$description": "Deepest inset panels (umber ramp)" },
      "surface-reference": { "$type": "color", "$value": "#161308", "$description": "Alternate page background (reference spec)" },
      "surface-container-low": { "$type": "color", "$value": "#1f1b10", "$description": "Low-emphasis panels" },
      "surface-container": { "$type": "color", "$value": "#231f14", "$description": "Default card fill on dark" },
      "surface-container-high": { "$type": "color", "$value": "#2e2a1d", "$description": "Raised panels" },
      "surface-container-highest": { "$type": "color", "$value": "#393527", "$description": "Highest panels, chips" },
      "surface-bright": { "$type": "color", "$value": "#3d392c", "$description": "Brightest surface" },
      "surface": { "$type": "color", "$value": "#141009", "$description": "Legacy Surface (Tobacco): existing card fill" },
      "elevated": { "$type": "color", "$value": "#1C160D", "$description": "Legacy Elevated Surface: existing raised panels" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#2A2015", "$description": "Umber: default border" },
      "hairline": { "$type": "color", "$value": "#3A2D1C", "$description": "Hairline: subtle divider; thick 2px structural borders" },
      "outline": { "$type": "color", "$value": "#9f8e7a", "$description": "High-visibility outline (reference spec)" },
      "outline-variant": { "$type": "color", "$value": "#524534", "$description": "Mid outline (reference spec)" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#F0E8D5", "$description": "Cream: primary text (16.11:1 on base, AAA)" },
      "on-surface": { "$type": "color", "$value": "#eae2cf", "$description": "Primary text on reference surfaces" },
      "secondary": { "$type": "color", "$value": "#A8997B", "$description": "Faded Ink: secondary text (7.03:1, AAA)" },
      "muted": { "$type": "color", "$value": "#7A6A50", "$description": "Muted Earth: quiet text, large text only (3.75:1)" },
      "on-surface-variant": { "$type": "color", "$value": "#d7c4ad", "$description": "Secondary text on umber panels" }
    },
    "accent": {
      "amber": { "$type": "color", "$value": "#FFB12B", "$description": "Signal Amber: PRIMARY action/focus color. Buttons, thick borders, highlighted headline words. Full-bleed amber section panels allowed with base-dark text." },
      "amber-press": { "$type": "color", "$value": "#E0920C", "$description": "Amber Press: deep accent / pressed state" },
      "amber-glow": { "$type": "color", "$value": "#FFCB6B", "$description": "Amber Glow: light accent / hover" },
      "signal-orange": { "$type": "color", "$value": "#FF5E00", "$description": "Signal Orange: SECONDARY alert accent (full-bleed panels, 5%-opacity watermarks, kicker ticks, hover/invert states, single emphasized headline words) AND the logo mark." },
      "glow": { "$type": "color", "$value": "rgba(255, 177, 43, 0.4)", "$description": "Text-glow / outer-glow shadow color" },
      "amber-tint-1": { "$type": "color", "$value": "#FFE5AD", "$description": "Tonal ramp tint (brand board only)" },
      "amber-tint-2": { "$type": "color", "$value": "#FFF8E7", "$description": "Tonal ramp tint (brand board only)" }
    }
  },
  "fontFamily": {
    "display": { "$type": "fontFamily", "$value": ["Space Grotesk", "sans-serif"], "$description": "Display: massive viewport-scale uppercase headlines, buttons, wordmark. Weights 400/500/600/700 in repo." },
    "body": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Body / UI. Weights 400/500/600." },
    "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "monospace"], "$description": "Labels, eyebrows, numerics, data, code. Weights 400/500/700." }
  },
  "typography": {
    "display-huge": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.display}", "fontWeight": 700, "fontSize": "22vw", "lineHeight": 0.85, "letterSpacing": "-0.06em", "textCase": "uppercase" }, "$description": "One per page (the hero). Clamp on scrollable pages, e.g. clamp(64px, 22vw, 200px)." },
    "punchy-heading": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.display}", "fontWeight": 700, "fontSize": "14vw", "lineHeight": 0.9, "letterSpacing": "-0.05em", "textCase": "uppercase" }, "$description": "Section headlines. Clamp on scrollable pages, e.g. clamp(44px, 14vw, 130px)." },
    "headline-lg": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.display}", "fontWeight": 700, "fontSize": "36px", "lineHeight": 1.1 } },
    "body-lg": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.body}", "fontWeight": 500, "fontSize": "18px", "lineHeight": 1.5 } },
    "body": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.body}", "fontWeight": 400, "fontSize": "17px", "lineHeight": 1.6 } },
    "label-caps": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.mono}", "fontWeight": 700, "fontSize": "12px", "letterSpacing": "0.2em", "textCase": "uppercase" } },
    "data-mono": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.mono}", "fontWeight": 700, "fontSize": "10px", "lineHeight": 1 } }
  },
  "dimension": {
    "content-max-width": { "$type": "dimension", "$value": "1180px", "$description": "--maxw: .wrap max content width" },
    "reading-max-width": { "$type": "dimension", "$value": "720px", "$description": "--readw: article/prose measure" },
    "corner-radius": { "$type": "dimension", "$value": "0px", "$description": "Sharp corners on all primary containers, buttons, inputs. Only tiny status pips may be pills." },
    "border-thick": { "$type": "dimension", "$value": "2px", "$description": "Standard structural border" },
    "border-heavy": { "$type": "dimension", "$value": "4px", "$description": "Header underline / emphasis border" },
    "nav-height": { "$type": "dimension", "$value": "68px" }
  }
}
