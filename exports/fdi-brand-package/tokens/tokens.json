{
  "$description": "False Dawn Industries design tokens (W3C design-tokens format, importable into Figma via Tokens Studio). Values extracted verbatim from site/src/site.css and artifacts/mockup-sandbox/public/ads/brand.css. Signal Orange is the logo mark ONLY.",
  "color": {
    "background": {
      "base": { "$type": "color", "$value": "#0D0B08", "$description": "Base (Parchment Night): page background" },
      "surface": { "$type": "color", "$value": "#141009", "$description": "Surface (Tobacco): cards, panels" },
      "elevated": { "$type": "color", "$value": "#1C160D", "$description": "Elevated Surface: raised panels" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#2A2015", "$description": "Umber: default border" },
      "hairline": { "$type": "color", "$value": "#3A2D1C", "$description": "Hairline: subtle divider" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#F0E8D5", "$description": "Cream: primary text (16.11:1 on base, AAA)" },
      "secondary": { "$type": "color", "$value": "#A8997B", "$description": "Faded Ink: secondary text (7.03:1, AAA)" },
      "muted": { "$type": "color", "$value": "#7A6A50", "$description": "Muted: quiet text, large text only (3.75:1)" }
    },
    "accent": {
      "signal-orange": { "$type": "color", "$value": "#FF5E00", "$description": "LOGO MARK ONLY. Never used as a UI accent." },
      "amber": { "$type": "color", "$value": "#FFB12B", "$description": "Signal Amber: primary accent, links, primary buttons. Never large fills." },
      "amber-press": { "$type": "color", "$value": "#E0920C", "$description": "Amber Press: deep accent / pressed state" },
      "amber-glow": { "$type": "color", "$value": "#FFCB6B", "$description": "Amber Glow: light accent / hover" },
      "amber-tint-1": { "$type": "color", "$value": "#FFE5AD", "$description": "Tonal ramp tint (brand board only)" },
      "amber-tint-2": { "$type": "color", "$value": "#FFF8E7", "$description": "Tonal ramp tint (brand board only)" }
    }
  },
  "fontFamily": {
    "display": { "$type": "fontFamily", "$value": ["Space Grotesk", "sans-serif"], "$description": "Display / headings, buttons, wordmark. Weights 400/500/600/700." },
    "body": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Body / UI. Weights 400/500/600." },
    "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "monospace"], "$description": "Labels, eyebrows, numerics, data, code. Weights 400/500/700." }
  },
  "typography": {
    "display": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.display}", "fontWeight": 500, "fontSize": "72px", "lineHeight": 1 } },
    "h1": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.display}", "fontWeight": 600, "fontSize": "48px", "lineHeight": 1.08, "letterSpacing": "-0.015em" } },
    "h2": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.display}", "fontWeight": 600, "fontSize": "32px", "lineHeight": 1.08, "letterSpacing": "-0.015em" } },
    "body": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.body}", "fontWeight": 400, "fontSize": "17px", "lineHeight": 1.6 } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.mono}", "fontWeight": 400, "fontSize": "12px", "letterSpacing": "0.28em", "textCase": "uppercase" } }
  },
  "dimension": {
    "content-max-width": { "$type": "dimension", "$value": "1180px", "$description": "--maxw: .wrap max content width" },
    "reading-max-width": { "$type": "dimension", "$value": "720px", "$description": "--readw: article/prose measure" },
    "button-radius": { "$type": "dimension", "$value": "8px" },
    "nav-height": { "$type": "dimension", "$value": "68px" }
  }
}
