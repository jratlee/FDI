modules = ["python-3.12", "nodejs-20", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["replitmail:1.0.0", "resend:1.0.0", "javascript_openai_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cairo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "libxcrypt", "pkg-config", "qhull", "tcl", "tk", "xsimd"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "site-links"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "audit-report"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "site-links-outbound"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "davos-gate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "competitive-analysis-pdf"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/build.mjs && node site/serve.mjs"
waitForPort = 5000

[[workflows.workflow]]
name = "site-links"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/check.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "audit-report"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node skillfoundry/schema/validate-report.mjs && node skillfoundry/schema/test-validator.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "site-links-outbound"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/link-check.mjs"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "davos-gate"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/gate-check.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "competitive-analysis-pdf"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node exports/skillfoundry-competitive-analysis/check-pdf.mjs"

[workflows.workflow.metadata]
isValidation = true

[deployment]
deploymentTarget = "autoscale"
run = ["node", "site/serve.mjs"]
build = ["bash", "-c", "npm --prefix site ci && node site/check.mjs"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
RESEND_FROM = "False Dawn Industries <onboarding@resend.dev>"
WAITLIST_NOTIFY_EMAIL = "john@ratcliffe-lee.com"
RESEND_REPLY_TO = "john@ratcliffe-lee.com"
# Canonical production origin for the scheduled link checker.
# Set to the deployed URL, e.g. https://falsedawn.industries
SITE_BASE_URL = ""
# Random secret that protects the /api/cron/link-check HTTP trigger endpoint.
# Set to any strong random string; pass it as ?secret=<value> or
# Authorization: Bearer <value> when calling from a cron service.
# Leave blank to disable the endpoint entirely.
CRON_SECRET = ""

[userenv.development]
DAVOSKIT_TIER1_PRICE_ID = "price_1TrNbuIr6q4Tm9bcIzcEhR8c"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5091
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 3000
