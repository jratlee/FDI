modules = ["python-3.12", "nodejs-20", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["replitmail:1.0.0", "resend:1.0.0", "javascript_openai_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cairo", "cargo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "libiconv", "libxcrypt", "pkg-config", "qhull", "rustc", "tcl", "tk", "xsimd"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "site-links"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "audit-report"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "site-links-outbound"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "davos-gate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "commerce-gates"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cron-link-check-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cron-silence-check-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "field-guide-bundle-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "marcom-starter-pack-check"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/build.mjs && node site/serve.mjs"
waitForPort = 5000

[[workflows.workflow]]
name = "site-links"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/check.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "audit-report"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node skillfoundry/schema/validate-report.mjs && node skillfoundry/schema/test-validator.mjs && node skillfoundry/engine/test-audit.mjs"

[[workflows.workflow]]
name = "site-links-outbound"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/link-check.mjs"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "davos-gate"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/build.mjs && node site/gate-check.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "commerce-gates"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/build.mjs && node site/test-commerce-gates.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "cron-link-check-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/build.mjs && node site/test-cron-link-check.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "cron-silence-check-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/build.mjs && node site/test-cron-silence.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "field-guide-bundle-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/build.mjs && node site/check-field-guide-bundle.mjs"

[workflows.workflow.metadata]
outputType = "console"
isValidation = true

[[workflows.workflow]]
name = "marcom-starter-pack-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node site/build.mjs && node site/check-marcom-starter-pack.mjs"

[workflows.workflow.metadata]
outputType = "console"
isValidation = true

[deployment]
deploymentTarget = "autoscale"
run = ["node", "site/serve.mjs"]
build = ["bash", "-c", "npm --prefix site ci && node site/check.mjs"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
RESEND_FROM = "False Dawn Industries <onboarding@resend.dev>"
WAITLIST_NOTIFY_EMAIL = "john@ratcliffe-lee.com"
RESEND_REPLY_TO = "john@ratcliffe-lee.com"
# Canonical production origin for the scheduled link checker.
# Set to the deployed URL, e.g. https://falsedawn.industries
SITE_BASE_URL = ""
# Random secret that protects both /api/cron/* HTTP trigger endpoints.
# Set to any strong random string; pass it as Authorization: Bearer <value>
# when calling from a cron service (see site/cron-schedule.json).
# Leave blank to disable both endpoints entirely.
CRON_SECRET = ""
# Silence monitor thresholds (optional — defaults shown).
# SILENCE_THRESHOLD_H: hours of no recorded run before an alert fires (default 48).
# ALERT_COOLDOWN_H: minimum hours between consecutive silence alerts (default 24).
SILENCE_THRESHOLD_H = ""
ALERT_COOLDOWN_H = ""

[userenv.development]
CRON_SECRET = "cron-dev-local-only-not-for-production"
DAVOSKIT_TIER1_PRICE_ID = "price_1TrNbuIr6q4Tm9bcIzcEhR8c"
MARCOMKIT_AUDIT_PRICE_ID = "price_1Tyz01Ir6q4Tm9bcjfnmgBqB"
MARCOMKIT_SPRINT_PRICE_ID = "price_1Tyz01Ir6q4Tm9bcq8vnYtSS"
MARCOMKIT_TIER1_PRICE_ID = "price_1TyyzzIr6q4Tm9bcZpKrj4LI"
MARCOMKIT_TIER2_AGENCY_PRICE_ID = "price_1Tyz00Ir6q4Tm9bcPdxEBf78"
MARCOMKIT_TIER2_ANNUAL_PRICE_ID = "price_1Tyz00Ir6q4Tm9bcq6qAUMiC"
MARCOMKIT_TIER2_MONTHLY_PRICE_ID = "price_1TyyzzIr6q4Tm9bcw0qRdPar"
MARCOMKIT_TIER3_PRICE_ID = "price_1Tyz01Ir6q4Tm9bcHaicqQ4z"

[userenv.production]
SITE_ORIGIN = "https://falsedawn.industries"

